# ==========================================
# YouTube Shorts Automation - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ==========================================

# --- AI / LLM APIs (Script & Prompt Generation) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- YouTube Data API v3 (Uploads & Channel Management) ---
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# --- Voice / TTS Services ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Stock Footage / Media Assets ---
PEXELS_API_KEY=

# --- Channel / Bot Configuration ---
CHANNEL_NAME=
CHANNEL_NICHE=
OUTPUT_DIR=output
